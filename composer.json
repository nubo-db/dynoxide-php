{
    "name": "nubo-db/dynoxide",
    "description": "Start a Dynoxide DynamoDB emulator from PHP tests: downloads, verifies and runs the binary, with a PHPUnit extension.",
    "type": "library",
    "license": "MIT OR Apache-2.0",
    "keywords": ["dynamodb", "dynoxide", "emulator", "testing", "phpunit", "aws"],
    "homepage": "https://dynoxide.dev",
    "support": {
        "issues": "https://github.com/nubo-db/dynoxide-php/issues",
        "source": "https://github.com/nubo-db/dynoxide-php"
    },
    "require": {
        "php": "^8.1",
        "ext-zlib": "*",
        "composer-runtime-api": "^2.2"
    },
    "require-dev": {
        "brianium/paratest": "^7.3",
        "pestphp/pest": "^3.8 || ^4.1 || ^5.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.4"
    },
    "suggest": {
        "ext-zip": "Needed on Windows to unpack the release archive",
        "ext-openssl": "Needed to download the binary over HTTPS"
    },
    "autoload": {
        "psr-4": { "Dynoxide\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Dynoxide\\Tests\\": "tests/" }
    },
    "bin": ["bin/dynoxide"],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}

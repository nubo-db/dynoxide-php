<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="{{AUTOLOAD}}" colors="false">
    <testsuites>
        <testsuite name="fixture">
            <directory>{{TESTS}}</directory>
        </testsuite>
    </testsuites>
    <extensions>
        <bootstrap class="Dynoxide\PHPUnit\Extension">{{PARAMETERS}}</bootstrap>
    </extensions>
</phpunit>
